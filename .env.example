# Nomi dei segreti del progetto. Questo file non contiene mai valori.
# I valori stanno solo nei segreti di GitHub Codespaces assegnati a questo repository
# (github.com → Settings → Codespaces → Secrets). Codespaces li espone come variabili d'ambiente.

# Token personale Supabase, letto dalla CLI (supabase link, supabase projects list). Task 0b.
SUPABASE_ACCESS_TOKEN=

# Riferimento del progetto remoto: i 20 caratteri in https://<ref>.supabase.co. Task 0b.
# Nome volutamente diverso da SUPABASE_PROJECT_ID, che la CLI userebbe per i container locali.
SUPABASE_PROJECT_REF=

# Password del database remoto (utente postgres), letta dalla CLI (supabase link, supabase db push). Task 0b.
SUPABASE_DB_PASSWORD=
